# Copy to .env and fill in your real values
PORT=5050
NODE_ENV=development

# Primary Groq key (required)
GROQ_API_KEY=your_groq_api_key_here

# Fallback keys — used automatically when the previous one hits its rate limit
GROQ_API_KEY_2=your_second_key_here
GROQ_API_KEY_3=your_third_key_here
# GROQ_API_KEY_4=...
# GROQ_API_KEY_5=...

# Optional model rotation list (comma separated). Falls back to the next
# model if every key is exhausted.
GROQ_MODELS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct

CLIENT_ORIGIN=http://localhost:5173
# Vision model used to mark faults on scan images
GROQ_VISION_MODELS=qwen/qwen3.6-27b
